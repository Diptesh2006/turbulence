# Shared
ENVIRONMENT=development
APP_VERSION=0.1.0

# API
SERVICE_NAME=turbulence-api
SIMULATION_MODE=disabled
DATABASE_URL=sqlite+aiosqlite:///./turbulence.db
CORS_ORIGINS=http://localhost:3000
CNAI_API_KEY=
CNAI_BASE_URL=https://api.concentrate.ai/v1
CNAI_TIMEOUT_SECONDS=30
CNAI_MODE=mock
WORKLOAD_MAX_OUTPUT_TOKENS=128
MAX_SIMULATION_REQUESTS=100
MAX_SIMULATION_CONCURRENCY=10
OPENAI_MODEL_ID=gpt-4.1-mini
ANTHROPIC_MODEL_ID=claude-3-5-haiku-latest
GOOGLE_MODEL_ID=gemini-1.5-flash
MOCK_MODEL_ID=mock-fast

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
